FROM node:22-bookworm-slim
WORKDIR /app
COPY src/ ./src/
# Checking and bundling the source was most of the build time, so the bundle
# is kept in a build cache between builds.
RUN --mount=type=cache,target=/var/cache/bundle \
    if [ ! -f /var/cache/bundle/server.js ]; then \
      node --check src/server.js && cp src/server.js /var/cache/bundle/server.js; \
    fi \
 && cp /var/cache/bundle/server.js /app/server.js
CMD ["node", "/app/server.js"]
