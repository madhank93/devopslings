#!/usr/bin/env bash
# obs-reset — put every editable file back to the baseline and bring the stack
# to a known state: apps running, no silences, empty sink, configs loaded.
# Every lesson's init_scenario starts here, so one lesson's leftovers never
# leak into the next.
set -euo pipefail
. /usr/local/lib/obs.sh

for d in prometheus prometheus-2 prometheus-3 alertmanager blackbox loki-rules grafana apps queries otel vector answers portal hosts; do
  rm -rf "/obs/$d"
  [ -e "/opt/obs-baseline/$d" ] && cp -a "/opt/obs-baseline/$d" "/obs/$d"
done
rm -f /obs/run/*.down /obs/run/*.restart /obs/run/*.fault /obs/run/*.slow
for a in $OBS_IDLE_APPS; do app_down "$a"; done
mkdir -p /obs/answers /obs/otel/out
chmod -R a+rwX /obs/otel/out
chmod -R a+rX /obs

obs_reload >/dev/null
obs_expire_silences
sink_reset
curl -s --max-time 10 -X PUT "$PUSHGW/api/v1/admin/wipe" >/dev/null || true
