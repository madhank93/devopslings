#!/usr/bin/env bash
# supervise NAME CMD... — keep one app running and let files steer it.
#
#   /obs/run/NAME.down     present: keep the app stopped
#   /obs/run/NAME.restart  appears: restart once (the file is consumed)
#   its source file        changes: restart, so an edited app goes live on save
#
# Output goes to /obs/logs/NAME.log, which is where a student reads the
# traceback of an app they broke. /obs/run/NAME.started holds the epoch second
# of the latest start, so a check can tell a restart happened.
set -u
name=$1; shift
run=/obs/run; log=/obs/logs/$name.log
mkdir -p "$run" /obs/logs

# The watched sources are the arguments that are files under /obs/apps. Content,
# not mtime, so rewriting a file with the same bytes restarts nothing.
watch=()
for a in "$@"; do case $a in /obs/apps/*) watch+=("$a") ;; esac; done
stamp() { cat "${watch[@]}" 2>/dev/null | md5sum; }

trap 'kill "$pid" 2>/dev/null; exit 0' TERM INT
pid=
while :; do
  if [ -e "$run/$name.down" ]; then sleep 0.5; continue; fi
  rm -f "$run/$name.restart"
  before=$(stamp)
  "$@" >>"$log" 2>&1 &
  pid=$!
  date +%s > "$run/$name.started"
  while kill -0 "$pid" 2>/dev/null; do
    sleep 0.5
    if [ -e "$run/$name.down" ] || [ -e "$run/$name.restart" ] || [ "$(stamp)" != "$before" ]; then
      break
    fi
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
  else
    wait "$pid" 2>/dev/null
    echo "[supervise] $name exited with status $?; restarting in 1s" >>"$log"
    sleep 1
  fi
done
