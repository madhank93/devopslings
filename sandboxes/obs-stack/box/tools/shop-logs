#!/usr/bin/env python3
"""shop-logs — a fresh batch of shop's access logs, shipped through Vector.

  shop-logs [N]              print N JSON lines (default 6000) to stdout
  shop-logs ship [N] [KEEP]  ship N lines to Loki with Vector, using the
                             transforms and sinks in /obs/vector/ship.yaml fed
                             by a stdin source named `shop`; KEEP, when given,
                             receives the lines that were sent

Every line is a new request with a new request_id, timestamped as Vector reads
it, so each batch lands in its own slice of time.
"""
import json
import os
import random
import subprocess
import sys
import tempfile

SERVICES = [("search", 30), ("catalog", 25), ("cart", 15), ("orders", 12), ("auth", 10), ("payments", 8)]
PATHS = {"search": lambda r: f"/search?q={r.choice(['boots', 'socks', 'hat', 'scarf'])}",
         "catalog": lambda r: f"/catalog/item/{r.randrange(100000)}",
         "cart": lambda r: "/cart", "orders": lambda r: f"/orders/{r.randrange(100000)}",
         "auth": lambda r: "/auth/login", "payments": lambda r: "/payments/charge"}


def batch(n, r):
    names, weights = zip(*SERVICES)
    for _ in range(n):
        svc = r.choices(names, weights)[0]
        x = r.random()
        level, status = ("error", r.choice([500, 503])) if x < 0.02 else \
            ("warn", 429) if x < 0.08 else ("info", 200)
        yield json.dumps({"level": level, "service": svc, "request_id": f"req-{r.getrandbits(48):012x}",
                          "method": "GET", "path": PATHS[svc](r), "status": status,
                          "duration_ms": r.randrange(2, 900), "customer": f"c-{r.randrange(10000):04d}"},
                         separators=(",", ":"))


def main(argv):
    r = random.Random()
    if argv[:1] != ["ship"]:
        for line in batch(int(argv[0]) if argv else 6000, r):
            print(line)
        return 0
    n = int(argv[1]) if len(argv) > 1 else 6000
    lines = list(batch(n, r))
    if len(argv) > 2:
        open(argv[2], "w").write("\n".join(lines) + "\n")
    with tempfile.TemporaryDirectory() as d:
        src = os.path.join(d, "source.yaml")
        open(src, "w").write(f"data_dir: {d}\nsources:\n  shop:\n    type: stdin\n")
        p = subprocess.run(["vector", "--quiet", "-c", src, "-c", "/obs/vector/ship.yaml"],
                           input="\n".join(lines) + "\n", text=True, capture_output=True, timeout=120)
    sys.stderr.write(p.stdout + p.stderr)
    if p.returncode == 0:
        sample = next((json.loads(l) for l in lines if "\"payments\"" in l and "\"error\"" in l), {"request_id": "(none this batch)"})
        print(f"shipped {n} lines; a payments error to look up: {sample['request_id']}")
    return p.returncode


sys.exit(main(sys.argv[1:]))
