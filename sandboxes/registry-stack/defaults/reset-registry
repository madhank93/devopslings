#!/bin/sh
# Put the registry's configuration and users back to the sandbox defaults and
# restart it. Lessons call this first, so one lesson's policy or account never
# leaks into the next.
set -eu
cp /opt/registry-defaults/config.json /etc/registry/config.json
htpasswd -Bbc /etc/registry/htpasswd devops devopslings 2>/dev/null
docker restart devopslings-zot >/dev/null
i=0
until curl -s -o /dev/null http://127.0.0.1:15000/v2/; do
  i=$((i + 1))
  [ "$i" -lt 60 ] || { echo "registry did not come back after a restart" >&2; exit 1; }
  sleep 1
done
