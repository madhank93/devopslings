#!/usr/bin/env python3
"""Write a minimal pure-Python wheel into a PEP 503 "simple" index directory.

  mkwheel INDEX NAME VERSION [--build N] [--requires SPEC]... [--origin TEXT]

The wheel lands in INDEX/<normalized name>/, which is the layout pip reads when
INDEX is served over HTTP with a directory listing (python3 -m http.server).
The package's module records ORIGIN, so a grader can tell which index a
installed copy came from.
"""
import argparse
import base64
import hashlib
import os
import re
import zipfile

p = argparse.ArgumentParser()
p.add_argument("index")
p.add_argument("name")
p.add_argument("version")
p.add_argument("--build")
p.add_argument("--requires", action="append", default=[])
p.add_argument("--origin", default="")
a = p.parse_args()

project = re.sub(r"[-_.]+", "-", a.name).lower()
dist = project.replace("-", "_")
info = f"{dist}-{a.version}.dist-info"
files = {
    f"{dist}/__init__.py": f'__version__ = "{a.version}"\nORIGIN = {a.origin!r}\n',
    f"{info}/METADATA": "Metadata-Version: 2.1\n"
    f"Name: {a.name}\nVersion: {a.version}\n"
    + "".join(f"Requires-Dist: {r}\n" for r in a.requires),
    f"{info}/WHEEL": "Wheel-Version: 1.0\nGenerator: mkwheel\n"
    "Root-Is-Purelib: true\nTag: py3-none-any\n"
    + (f"Build: {a.build}\n" if a.build else ""),
}
record = []
for path, body in files.items():
    h = base64.urlsafe_b64encode(hashlib.sha256(body.encode()).digest()).rstrip(b"=")
    record.append(f"{path},sha256={h.decode()},{len(body.encode())}")
record.append(f"{info}/RECORD,,")
files[f"{info}/RECORD"] = "\n".join(record) + "\n"

os.makedirs(os.path.join(a.index, project), exist_ok=True)
build = f"-{a.build}" if a.build else ""
out = os.path.join(a.index, project, f"{dist}-{a.version}{build}-py3-none-any.whl")
with zipfile.ZipFile(out, "w") as z:
    for path, body in sorted(files.items()):
        # A fixed timestamp makes the same package byte-identical on every
        # build, so a hash in a lockfile stays valid across scenario resets.
        z.writestr(zipfile.ZipInfo(path, (2020, 1, 1, 0, 0, 0)), body)
print(out)
