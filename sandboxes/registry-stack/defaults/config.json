{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "auth": {
      "htpasswd": { "path": "/etc/registry/htpasswd" }
    },
    "accessControl": {
      "repositories": {
        "upstream/**": { "anonymousPolicy": ["read"], "defaultPolicy": [] },
        "**": { "defaultPolicy": [] }
      },
      "adminPolicy": {
        "users": ["devops"],
        "actions": ["read", "create", "update", "delete"]
      }
    }
  },
  "log": { "level": "info" },
  "extensions": { "search": { "enable": true } }
}
