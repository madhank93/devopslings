[Unit]
Description=the second upstream application
# Only the box that is meant to be the upstream has this marker; compose binds
# it in. One image serves all three boxes, and a stray listener on 8080 would
# give the proxy lessons a second place to point at.
ConditionPathExists=/etc/upstream/enabled
After=network.target

[Service]
Environment=UPSTREAM_NAME=b UPSTREAM_PORT=8090 UPSTREAM_ADMIN_PORT=8091
ExecStart=/usr/bin/python3 /opt/upstream/upstream.py
Restart=always

[Install]
WantedBy=multi-user.target
