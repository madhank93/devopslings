#!/usr/bin/env python3
"""Open a websocket, echo through it, wait, and echo again.

Exists so that "the socket dies after N seconds" is something you can measure
rather than something the client's logs assert.
"""
import argparse
import base64
import hashlib
import os
import socket
import struct
import sys
import time
from urllib.parse import urlsplit

GUID = "258EAFA5-E914-47DA-95CA-5AB0DC85B39A"


def send(sock, opcode, payload=b""):
    # Client-to-server frames must be masked, per RFC 6455.
    mask = os.urandom(4)
    head = bytearray([0x80 | opcode])
    n = len(payload)
    if n < 126:
        head.append(0x80 | n)
    elif n < 65536:
        head.append(0x80 | 126)
        head += struct.pack(">H", n)
    else:
        head.append(0x80 | 127)
        head += struct.pack(">Q", n)
    body = bytes(c ^ mask[i % 4] for i, c in enumerate(payload))
    sock.sendall(bytes(head) + mask + body)


def readn(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise EOFError("connection closed by the other end")
        buf += chunk
    return buf


def recv(sock):
    hdr = readn(sock, 2)
    opcode = hdr[0] & 0x0F
    n = hdr[1] & 0x7F
    if n == 126:
        n = struct.unpack(">H", readn(sock, 2))[0]
    elif n == 127:
        n = struct.unpack(">Q", readn(sock, 8))[0]
    data = readn(sock, n) if n else b""
    return opcode, data


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("url", help="http://host:port/path")
    ap.add_argument("--idle", type=float, default=0, help="seconds to stay silent mid-connection")
    ap.add_argument("--timeout", type=float, default=30, help="socket timeout for each read")
    args = ap.parse_args()

    u = urlsplit(args.url)
    host = u.hostname
    port = u.port or 80
    path = u.path or "/"

    key = base64.b64encode(os.urandom(16)).decode()
    sock = socket.create_connection((host, port), timeout=args.timeout)
    sock.settimeout(args.timeout + args.idle)
    sock.sendall(
        (
            "GET %s HTTP/1.1\r\n"
            "Host: %s\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            "Sec-WebSocket-Key: %s\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n" % (path, u.netloc, key)
        ).encode()
    )

    head = b""
    while b"\r\n\r\n" not in head:
        chunk = sock.recv(4096)
        if not chunk:
            print("handshake failed: the connection closed with no response")
            return 1
        head += chunk
    status = head.split(b"\r\n", 1)[0].decode(errors="replace")
    if " 101 " not in status:
        print("handshake failed: %s" % status)
        return 1

    want = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()
    if want.encode() not in head:
        print("handshake failed: Sec-WebSocket-Accept did not match the key sent")
        return 1

    send(sock, 0x1, b"hello")
    op, data = recv(sock)
    if op != 0x1 or data != b"hello":
        print("first echo failed: opcode=%s payload=%r" % (op, data))
        return 1

    if args.idle:
        time.sleep(args.idle)

    try:
        send(sock, 0x1, b"still-here")
        op, data = recv(sock)
    except (EOFError, OSError) as exc:
        print("the socket did not survive %gs of silence: %s" % (args.idle, exc))
        return 1
    if op != 0x1 or data != b"still-here":
        print("second echo failed after %gs idle: opcode=%s payload=%r" % (args.idle, op, data))
        return 1

    send(sock, 0x8)
    sock.close()
    print("ok: echoed before and after %gs idle" % args.idle)
    return 0


if __name__ == "__main__":
    sys.exit(main())
